# Export headers for packaging
exports_files(glob(["*.hpp"]))

filegroup(
    name = "public_headers",
    srcs = glob(["*.hpp"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "shared_interp",
    hdrs = ["shared_interp.hpp"],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/option/table",
    include_prefix = "mango/option/table",
)

cc_library(
    name = "adaptive_grid_types",
    hdrs = ["adaptive_grid_types.hpp"],
    deps = [
        ":strike_bounds",
        ":moneyness_bounds",
        "//src/option:option_spec",
    ],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/option/table",
    include_prefix = "mango/option/table",
)

cc_library(
    name = "reference_selection",
    srcs = ["reference_selection.cpp"],
    hdrs = ["reference_selection.hpp"],
    deps = [
        ":adaptive_grid_types",
        ":adaptive_refinement",
        "//src/support:error_types",
    ],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/option/table",
    include_prefix = "mango/option/table",
)

cc_library(
    name = "pde_cache",
    hdrs = ["pde_cache.hpp"],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/option/table",
    include_prefix = "mango/option/table",
)

cc_library(
    name = "adaptive_refinement",
    srcs = ["adaptive_refinement.cpp"],
    hdrs = ["adaptive_refinement.hpp"],
    copts = [
        "-fopenmp",
        "-pthread",
    ],
    linkopts = [
        "-fopenmp",
        "-pthread",
    ],
    deps = [
        ":adaptive_grid_types",
        ":price_table",
        ":tau_segment_split",
        "//src/option:dividend_utils",
        "//src/option:option_grid",
        "//src/option:option_spec",
        "//src/math:latin_hypercube",
        "//src/support:error_types",
    ],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/option/table",
    include_prefix = "mango/option/table",
)

# Option-domain adapters for the generic refinement loop: the FD reference
# solver (ValidateFn), FD-vega reference generator (PrepareRefsFn), and
# IV-error scoring metric (ScoreErrorFn).  Kept out of :adaptive_refinement
# so the loop never depends on the American PDE solver.
cc_library(
    name = "adaptive_metrics",
    srcs = ["adaptive_metrics.cpp"],
    hdrs = ["adaptive_metrics.hpp"],
    deps = [
        ":adaptive_grid_types",
        ":adaptive_refinement",
        "//src/option:american_option",
        "//src/option:dividend_utils",
        "//src/option:option_spec",
        "//src/support:error_types",
    ],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/option/table",
    include_prefix = "mango/option/table",
)

