# SPDX-License-Identifier: MIT
cc_library(
    name = "chebyshev_nodes",
    hdrs = ["chebyshev_nodes.hpp"],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/math/chebyshev",
    include_prefix = "mango/math/chebyshev",
)

cc_library(
    name = "raw_tensor",
    hdrs = ["raw_tensor.hpp"],
    copts = ["-fopenmp"],
    deps = ["//src/support:parallel"],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/math/chebyshev",
    include_prefix = "mango/math/chebyshev",
)

cc_library(
    name = "chebyshev_interpolant",
    hdrs = ["chebyshev_interpolant.hpp"],
    copts = ["-fopenmp"],
    deps = [
        ":chebyshev_nodes",
        "//src/support:error_types",
        "//src/support:parallel",
    ],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/math/chebyshev",
    include_prefix = "mango/math/chebyshev",
)

# Convenience: interpolant + raw storage (no Eigen dep)
cc_library(
    name = "chebyshev_tensor",
    deps = [":chebyshev_interpolant", ":raw_tensor"],
    visibility = ["//visibility:public"],
)


# Explicit opt-in polynomial preparation; no financial factory dispatch yet.
cc_library(
    name = "chebyshev_modal_interpolant",
    hdrs = ["chebyshev_modal_interpolant.hpp"],
    deps = [":chebyshev_interpolant", ":chebyshev_polynomial", "//src/support:error_types"],
    visibility = ["//visibility:public"],
    strip_include_prefix = "/src/math/chebyshev",
    include_prefix = "mango/math/chebyshev",
)

cc_library(
    name = "chebyshev_polynomial",
    srcs = ["chebyshev_polynomial.cpp"],
    hdrs = ["chebyshev_polynomial.hpp"],
    copts = ["-O3", "-fno-fast-math", "-ffp-contract=off"],
    visibility = ["//src:__subpackages__", "//tests:__subpackages__", "//benchmarks:__subpackages__"],
    strip_include_prefix = "/src/math/chebyshev",
    include_prefix = "mango/math/chebyshev",
)
